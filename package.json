{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun install --frozen-lockfile && bun --bun next build",
    "export": "bun --bun next export",
    "start": "bun --bun next start",
    "postinstall": "bun pm ls typescript @types/react @types/node || bun add typescript @types/react @types/node @types/react-dom"
  },
  "dependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.13",
    "fast-xml-parser": "^5.2.5",
    "framer-motion": "^10.12.16",
    "motion": "^12.23.24",
    "next": "^14.0.0",
    "openai": "^5.18.1",
    "postcss": "^8.4.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.5.2",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.8.3"
  }
}
